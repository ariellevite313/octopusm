[Unit]
Description=OMdotfun DRC-20 indexer
After=network-online.target dogecoind.service
Wants=dogecoind.service

[Service]
WorkingDirectory=/opt/drc20-indexer
EnvironmentFile=/opt/drc20-indexer/.env
ExecStart=/opt/drc20-indexer/node_modules/.bin/tsx src/main.ts
# tsx local (installé par npm ci) : rien n'est téléchargé au démarrage
Restart=always
RestartSec=15
User=doge

[Install]
WantedBy=multi-user.target
