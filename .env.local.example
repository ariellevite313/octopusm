# ──────────────────────────────────────────────────────────────────────────────
# Octopus Market (Next.js) — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# Ne jamais committer .env.local dans Git
# ──────────────────────────────────────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXXXXXX

# Solana RPC — Helius (https://helius.dev → créer un compte gratuit)
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=VOTRE_API_KEY

# ── Arc Network ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ARC_TREASURY_ADDRESS=0xYourTreasuryAddress

# ── Memes × Stocks — Mock xStock ERC-20 addresses (Arc testnet) ───────────────
# Obtenir via : forge script arc-launchpad/script/Deploy.s.sol --broadcast
NEXT_PUBLIC_XNVDA_ADDRESS=0x...
NEXT_PUBLIC_XTSLA_ADDRESS=0x...
NEXT_PUBLIC_XMSTR_ADDRESS=0x...
NEXT_PUBLIC_XAAPL_ADDRESS=0x...
NEXT_PUBLIC_XSPY_ADDRESS=0x...
